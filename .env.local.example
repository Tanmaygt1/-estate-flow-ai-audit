# ─────────────────────────────────────────────────────────────
# RENAME THIS FILE TO: .env.local  (never commit .env.local)
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── xAI Grok ──────────────────────────────────────────────────
# https://console.x.ai → API Keys
XAI_API_KEY=xai-your-key-here

# ── Email (Nodemailer / Gmail SMTP) ───────────────────────────
# Use Gmail App Password (not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Master email (receives copy of every audit) ───────────────
MASTER_EMAIL=your-admin-email@gmail.com
